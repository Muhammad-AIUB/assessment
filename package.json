{
  "name": "pharmastock",
  "version": "1.0.0",
  "description": "Batch & expiry-aware stock, FEFO sales and demand forecasting for small pharmacies",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "setup": "npm run migrate && npm run seed",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1",
    "test:unit": "node --test test/fefo.unit.test.js test/forecast.unit.test.js test/api.unit.test.js",
    "backtest": "node scripts/backtest-report.js",
    "backtest:csv": "node scripts/backtest-csv.js",
    "db:reset": "node scripts/migrate.js --reset",
    "lint": "eslint .",
    "dataset:pharmacy": "node scripts/prepare-pharmacy-dataset.js data/external/mendeley-pharmacy/sales.sql data/external/pharmacy-daily.csv"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  }
}
